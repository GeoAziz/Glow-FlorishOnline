
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user has a specific role
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Helper function to check if a user is an admin
    function isAdmin() {
      return isRole('admin');
    }

    // Helper function to check if a user is a moderator
    function isModerator() {
      return isRole('moderator');
    }
    
    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Anyone can read products and categories
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(); // Only admins can create, update, delete products
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin(); // Only admins can manage categories
    }

    // Users can only read/write their own document. Admins can read any.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Users can only manage their own cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users can only manage their own wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users can only create and read their own orders. Admins can read all orders.
    match /orders/{orderId} {
      allow read: if isAdmin() || get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
      allow create: if request.auth.uid != null; // Checked in transaction logic
      allow update: if isAdmin(); // Only admins can update order status
      allow delete: if false; // Orders should not be deleted
    }

    // Authenticated users can create reviews. Admins/Mods can update them (for approval).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }
    
    // Contact messages can be created by anyone, but only read/deleted by admins.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Newsletter subscriptions can be created by anyone, but only managed by admins.
    match /newsletter_subscriptions/{email} {
       allow create: if true;
       allow read, delete: if isAdmin();
    }
    
    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
